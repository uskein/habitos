{
  "expo": {
    "name": "Hábitos",
    "slug": "habitos",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "habitos",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.habitos.app"
    },
    "android": {
      "package": "com.habitos.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundColor": "#6D4BF5"
      },
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.SCHEDULE_EXACT_ALARM"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-secure-store",
      "expo-local-authentication",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#6D4BF5"
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#6D4BF5"
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "HabitWidget",
              "label": "Hábitos de hoy",
              "description": "Progreso del día y tus hábitos pendientes",
              "minWidth": "250dp",
              "minHeight": "110dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "updatePeriodMillis": 1800000
            },
            {
              "name": "HabitWidgetSmall",
              "label": "Hábitos (compacto)",
              "description": "Contador de hábitos completados y acceso rápido",
              "minWidth": "110dp",
              "minHeight": "110dp",
              "targetCellWidth": 2,
              "targetCellHeight": 2,
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ],
      "expo-sharing",
      "expo-asset"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "7756a9b3-eb11-4ba5-99a7-b5f4c3d85a8d"
      }
    },
    "owner": "uskein"
  }
}
