{
  "expo": {
    "name": "Hábitos",
    "slug": "habitos",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "habitos",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.habitos.app"
    },
    "android": {
      "package": "com.habitos.app",
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-secure-store",
      "expo-local-authentication",
      "expo-font",
      [
        "expo-notifications",
        {
          "color": "#6D4BF5"
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "7756a9b3-eb11-4ba5-99a7-b5f4c3d85a8d"
      }
    },
    "owner": "uskein"
  }
}
