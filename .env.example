# App Hábitos — variables de entorno (plantilla; copiar a .env.local)
# Regla: ningún secreto real se versiona. El MVP es 100% local (ADR-001).

# Identidad de la app
EXPO_PUBLIC_APP_NAME=Hábos
EXPO_PUBLIC_APP_SCHEME=habitos

# Bundle identifiers (usados por EAS / prebuild)
EXPO_PUBLIC_BUNDLE_ID=com.habitos.app
EXPO_PUBLIC_ANDROID_PACKAGE=com.habitos.app

# Fase 2 (NO usar aún — sync diferida, ADR-001)
# EXPO_PUBLIC_API_URL=
